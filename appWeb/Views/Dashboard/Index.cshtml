@{
    ViewData["Title"] = "Tableau de bord";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<h2 class="mb-4 text-center">Tableau de bord</h2>

<!-- 📊 Cartes de résumé -->
<div class="row mb-4">
    <div class="col-md-3 mb-2">
        <div class="card bg-primary text-white shadow rounded-3">
            <div class="card-body">
                <center>
                    <h3>Stagiaires</h3>
                    <h3>@ViewBag.StagiaireCount</h3>
                </center>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-2">
        <div class="card bg-success text-white shadow rounded-3">
            <div class="card-body">
                <center>
                <h3>Formations</h3>
                <h3>@ViewBag.FormationCount</h3>
                </center>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-2">
        <div class="card bg-info text-white shadow rounded-3">
            <div class="card-body">
                <center>
                    <h3>Encadrants</h3>
                    <h3>@ViewBag.EncadrantCount</h3>
                </center>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-2">
        <div class="card bg-warning text-white shadow rounded-3">
            <div class="card-body">
                <center>
                    <h3>Certificats</h3>
                    <h3>@ViewBag.CertificatCount</h3>
                </center>
            </div>
        </div>
    </div>
</div>

<!-- ✅ Taux de complétion -->
<div class="mb-4">
    <div class="alert alert-info">
        <strong>Taux de complétion :</strong> @ViewBag.TauxCompletion %
    </div>
</div>

<!-- 👥 Derniers stagiaires -->
<center><h4>Derniers stagiaires inscrits</h4></center>
<br />
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Email</th>
            <th>Date de naissance</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in ViewBag.DerniersStagiaires)
        {
            <tr>
                <td>@s.Nom</td>
                <td>@s.Prenom</td>
                <td>@s.Email</td>
                <td>@s.DateNaissance.ToString("dd/MM/yyyy")</td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination stagiaires -->
<nav aria-label="Pagination" class="mt-3">
    <ul class="pagination justify-content-center">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = i, pageFormation = ViewBag.CurrentPageFormation })">@i</a>
            </li>
        }
    </ul>
</nav>

<!-- 🏆 Formations les plus populaires -->
<center><h4>Formations des stages les plus populaires</h4></center>
<br />
<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Titre</th>
            <th>Nombre de certificats délivrés</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in ViewBag.FormationsPopulaires)
        {
            <tr>
                <td>@f.Titre</td>
                <td>@f.NombreCertificats</td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination formations -->
<nav aria-label="Pagination des formations" class="mt-3">
    <ul class="pagination justify-content-center">
        @for (int i = 1; i <= ViewBag.TotalPagesFormation; i++)
        {
            <li class="page-item @(ViewBag.CurrentPageFormation == i ? "active" : "")">
                <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage, pageFormation = i })">@i</a>
            </li>
        }
    </ul>
</nav>

<!-- 📈 Graphique Chart.js -->
<center><h4>Graphique des formations populaires</h4></center>
<br />
<canvas id="formationsChart" height="100"></canvas>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var ctx = document.getElementById('formationsChart').getContext('2d');
        var chart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
             ((IEnumerable<dynamic>)ViewBag.FormationsPopulaires).Select(f => f.Titre)
         )),
                datasets: [{
                    label: 'Certificats délivrés',
                    data: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
               ((IEnumerable<dynamic>)ViewBag.FormationsPopulaires).Select(f => f.NombreCertificats)
           )),
                    backgroundColor: 'rgba(75, 192, 192, 0.6)',
                    borderColor: 'rgba(75, 192, 192, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                },
                plugins: {
                    legend: { display: false },
                    title: {
                        display: true,
                        text: 'Certificats délivrés par formation'
                    }
                }
            }
        });
    </script>
}
