@model appWeb.Models.Certificat
@{
    ViewData["Title"] = "Supprimer le certificat";
}
@section Styles {
    <link rel="stylesheet" href="~/css/site-delete.css" />
}
<h1 class="delete-title">Supprimer le certificat</h1>
<h3 class="delete-subtitle">Êtes-vous sûr de vouloir supprimer ce certificat ?</h3>

<div class="delete-card">
    <h4 class="section-title">Certificat</h4>
    <dl class="row">
        <dt class="col-sm-2">Stagiaire</dt>
        <dd class="col-sm-10">@Model.Stagiaire.Nom</dd>

        <dt class="col-sm-2">Formation</dt>
        <dd class="col-sm-10">@Model.Formation.Titre</dd>

        <dt class="col-sm-2">Date de génération</dt>
        <dd class="col-sm-10">@Model.DateGeneration.ToString("dd/MM/yyyy")</dd>
    </dl>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Supprimer</button>
    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
</form>
