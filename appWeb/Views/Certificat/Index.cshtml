@model IEnumerable<appWeb.Models.Certificat>

@{
    ViewData["Title"] = "Liste des certificats";
}

<style>
    .page-container {
        max-width: 960px;
        margin: auto;
        padding: 1rem;
    }

    h2 {
        text-align: center;
        margin-bottom: 1.5rem;
        color: #0d6efd; /* bleu Bootstrap primaire */
    }

    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-top: 1.5rem;
    }
    @@media (max-width: 576px) {
        .btn-sm

    {
        padding: 0.5rem 0.75rem;
        font-size: 1rem;
    }

    }
    /* Ajout d'un petit style pour les icônes dans les th */
    th i {
        margin-right: 6px;
        color: #0d6efd;
    }
</style>

<div class="page-container">
    <h2>@ViewData["Title"]</h2>

    <p class="text-center mb-4">
        <a asp-action="Create" class="btn btn-primary btn-lg">
            <i class="fas fa-plus-circle me-2"></i> Créer une nouvelle Certificat
        </a>
    </p>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-primary">
                <tr>
                    <th><i class="fas fa-user"></i> Stagiaire</th>
                    <th><i class="fas fa-graduation-cap"></i> Formation</th>
                    <th><i class="fas fa-calendar-alt"></i> Date de génération</th>
                    <th class="text-center"><i class="fas fa-cogs"></i> Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center fst-italic text-muted py-3">
                            Aucun certificat trouvé.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var cert in Model)
                    {
                        <tr>
                            <td>@cert.Stagiaire.Nom @cert.Stagiaire.Prenom</td>
                            <td>@cert.Formation.Titre</td>
                            <td>@cert.DateGeneration.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@cert.Id" class="btn btn-info btn-sm me-1" title="Détails">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@cert.Id" class="btn btn-warning btn-sm me-1" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@cert.Id" class="btn btn-danger btn-sm" title="Supprimer"
                                   onclick="return confirm('Confirmer la suppression de ce certificat ?');">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div class="fixed-pagination">
        <span>Page @ViewBag.CurrentPage sur @ViewBag.TotalPages</span>
            <div>
            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" class="btn btn-outline-primary btn-sm" aria-label="Page précédente">
                    <i class="fas fa-chevron-left"></i> Précédent
                </a>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <a asp-action="Index" asp-route-page="@i"
                   class="btn btn-sm @(i == ViewBag.CurrentPage ? "btn-primary" : "btn-outline-secondary")"
                   aria-current="@(i == ViewBag.CurrentPage ? "page" : null)">
                    @i
                </a>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" class="btn btn-outline-primary btn-sm" aria-label="Page suivante">
                    Suivant <i class="fas fa-chevron-right"></i>
                </a>
            }
            </div>
        </div>
    }
</div>
