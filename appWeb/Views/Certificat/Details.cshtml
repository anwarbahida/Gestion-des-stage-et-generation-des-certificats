@model appWeb.Models.Certificat
@{
    ViewData["Title"] = "Détails du certificat";
}
<h2 class="mb-4">@ViewData["Title"]</h2>

<div class="details-card">
    <div class="details-title">Informations du certificat</div>
    <dl class="row">
        <dt class="col-sm-3 details-label">Stagiaire</dt>
        <dd class="col-sm-9">@Model.Stagiaire.Nom</dd>

        <dt class="col-sm-3 details-label">Formation</dt>
        <dd class="col-sm-9">@Model.Formation.Titre</dd>

        <dt class="col-sm-3 details-label">Date de génération</dt>
        <dd class="col-sm-9">@Model.DateGeneration.ToString("dd/MM/yyyy")</dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Modifier</a>
    <a asp-action="Index" class="btn btn-secondary">Retour</a>
</div>
