@model IEnumerable<appWeb.Models.Certificat>

@{
    ViewData["Title"] = "Générer des certificats";
}

<style>
    .page-container {
        max-width: 960px;
        margin: auto;
        padding: 1rem;
    }

    h2 {
        text-align: center;
        margin-bottom: 1.5rem;
        color: #0d6efd; /* bleu Bootstrap primaire */
    }

    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    th i {
        margin-right: 6px;
        color: #0d6efd;
    }

    .btn-sm i {
        margin-right: 4px;
    }
</style>

<div class="page-container">
    <h2>@ViewData["Title"] Générer</h2>
    <br />
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-primary">
                <tr>
                    <th><i class="fas fa-user"></i> Stagiaire</th>
                    <th><i class="fas fa-chalkboard-teacher"></i> Formation</th>
                    <th><i class="fas fa-user-tie"></i> Encadrant</th>
                    <th><i class="fas fa-calendar-alt"></i> Date de génération</th>
                    <th class="text-center"><i class="fas fa-cogs"></i> Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center fst-italic text-muted py-3">
                            Aucun certificat trouvé.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var cert in Model)
                    {
                        <tr>
                            <td>@cert.Stagiaire.Nom @cert.Stagiaire.Prenom</td>
                            <td>@cert.Formation.Titre</td>
                            <td>@(cert.Formation.Encadrant != null ? cert.Formation.Encadrant.Nom + " " + cert.Formation.Encadrant.Prenom : "Aucun")</td>
                            <td>@cert.DateGeneration.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                   
                                <a asp-action="TelechargerPdf" asp-route-id="@cert.Id" class="btn btn-outline-primary btn-sm" title="Télécharger PDF">
                                    <i class="fas fa-download"></i> Générer PDF
                                </a>
                                <a asp-action="ImprimerPdf" asp-route-id="@cert.Id"
                                   target="_blank"
                                   class="btn btn-outline-primary btn-sm"
                                   title="Imprimer le certificat">
                                    <i class="fas fa-print"></i> Imprimer
                                </a>

                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div class="fixed-pagination">
            <span>Page @ViewBag.CurrentPage sur @ViewBag.TotalPages</span>

            <div>
                @if (ViewBag.CurrentPage > 1)
                {
                    <a asp-action="Generer" asp-route-page="@(ViewBag.CurrentPage - 1)" class="btn btn-outline-primary btn-sm" aria-label="Page précédente">
                        <i class="fas fa-chevron-left"></i> Précédent
                    </a>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <a asp-action="Generer" asp-route-page="@i"
                       class="btn btn-sm @(i == ViewBag.CurrentPage ? "btn-primary" : "btn-outline-secondary")"
                       aria-current="@(i == ViewBag.CurrentPage ? "page" : null)">
                        @i
                    </a>
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a asp-action="Generer" asp-route-page="@(ViewBag.CurrentPage + 1)" class="btn btn-outline-primary btn-sm" aria-label="Page suivante">
                        Suivant <i class="fas fa-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>

