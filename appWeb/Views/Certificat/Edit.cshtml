@model appWeb.Models.Certificat

@{
    ViewData["Title"] = "Modifier un certificat";
}

@section Styles {
    <link rel="stylesheet" href="~/css/site-Edit.css" />
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit" method="post" class="form-edit">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="StagiaireId" class="control-label">Stagiaire</label>
        <select asp-for="StagiaireId" class="form-control" asp-items="ViewBag.StagiaireId"></select>
        <span asp-validation-for="StagiaireId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="FormationId" class="control-label">Formation</label>
        <select asp-for="FormationId" class="form-control" asp-items="ViewBag.FormationId"></select>
        <span asp-validation-for="FormationId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DateGeneration" class="control-label">Date de Génération</label>
        <input asp-for="DateGeneration" class="form-control" type="date" />
        <span asp-validation-for="DateGeneration" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Enregistrer</button>
    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
