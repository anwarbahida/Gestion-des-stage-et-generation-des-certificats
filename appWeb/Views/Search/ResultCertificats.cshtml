@model IEnumerable<appWeb.Models.Certificat>

@{
    ViewData["Title"] = "Résultats de recherche - Certificats";
}

<style>
    .page-container {
        max-width: 960px;
        margin: auto;
        padding: 1rem;
    }

    h2 {
        text-align: center;
        margin-bottom: 1.5rem;
        color: #0d6efd;
    }

    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .btn-sm i {
        margin-right: 4px;
    }

    @@media (max-width: 576px) {
        .btn-sm {
            padding: 0.5rem 0.75rem;
            font-size: 1rem;
        }

        table th, table td {
            font-size: 0.9rem;
        }
    }

    th i {
        margin-right: 6px;
        color: #0d6efd;
    }

    .btn-retour {
        margin-top: 1rem;
    }

    .fixed-pagination span {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
    }

    .fixed-pagination div > a {
        margin: 0 2px;
    }
</style>

<div class="page-container">
    <h2>@ViewData["Title"]</h2>


    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center" role="alert">
            Aucun certificat trouvé pour votre recherche.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th><i class="fas fa-user-graduate"></i> Stagiaire</th>
                        <th><i class="fas fa-graduation-cap"></i> Formation</th>
                        <th><i class="fas fa-calendar-alt"></i> Date de génération</th>
                        <th class="text-center"><i class="fas fa-cogs"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cert in Model)
                    {
                        <tr>
                            <td>@cert.Stagiaire.Nom @cert.Stagiaire.Prenom</td>
                            <td>@cert.Formation.Titre</td>
                            <td>@cert.DateGeneration.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <a asp-controller="Certificat" asp-action="Details" asp-route-id="@cert.Id" class="btn btn-info btn-sm me-1" title="Détails">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                                <a asp-controller="Certificat" asp-action="Edit" asp-route-id="@cert.Id" class="btn btn-warning btn-sm me-1" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-controller="Certificat" asp-action="Delete" asp-route-id="@cert.Id" class="btn btn-danger btn-sm" title="Supprimer"
                                   onclick="return confirm('Confirmer la suppression de ce certificat ?');">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (ViewBag.TotalPages > 1)
    {
        <div class="fixed-pagination">
            <span>Page @ViewBag.CurrentPage sur @ViewBag.TotalPages</span>

            <div>
                @if (ViewBag.CurrentPage > 1)
                {
                    <a asp-controller="Certificat" asp-action="ResultatRecherche" asp-route-page="@(ViewBag.CurrentPage - 1)" class="btn btn-outline-primary btn-sm">
                        <i class="fas fa-chevron-left"></i> Précédent
                    </a>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <a asp-controller="Certificat" asp-action="ResultatRecherche" asp-route-page="@i"
                       class="btn btn-sm @(i == ViewBag.CurrentPage ? "btn-primary" : "btn-outline-secondary")">
                        @i
                    </a>
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a asp-controller="Certificat" asp-action="ResultatRecherche" asp-route-page="@(ViewBag.CurrentPage + 1)" class="btn btn-outline-primary btn-sm">
                        Suivant <i class="fas fa-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    }

    <div class="text-center btn-retour">
        <a asp-controller="Certificat" asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i> Retour à la liste des Certificats
        </a>
    </div>
</div>
