@model IEnumerable<appWeb.Models.Encadrant>

@{
    ViewData["Title"] = "Liste des Encadrants";
}

<style>
    .page-container {
        max-width: 960px;
        margin: auto;
        padding: 1rem;
    }


    h2 {
        text-align: center;
        margin-bottom: 1.5rem;
        color: #0d6efd; /* bleu Bootstrap primaire */
    }

    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    th i {
        margin-right: 6px;
        color: #0d6efd;
    }


    .btn-sm i {
        margin-right: 4px;
    }
    @@media (max-width: 576px) {
        .btn-sm

    {
        font-size: 1rem;
        padding: 0.4rem 0.75rem;
    }

    table th, table td {
        font-size: 0.9rem;
    }

    }

</style>

<div class="page-container">
    <h2>@ViewData["Title"]</h2>

    <p class="text-center mb-4">
        <a asp-action="Create" class="btn btn-primary btn-lg">
            <i class="fas fa-plus-circle me-2"></i> Ajouter un encadrant
        </a>
    </p>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-primary">
                <tr>
                    <th><i class="fas fa-user"></i> Nom</th>
                    <th><i class="fas fa-id-badge"></i> Prénom</th>
                    <th><i class="fas fa-envelope"></i> Email</th>
                    <th><i class="fas fa-phone"></i> Téléphone</th>
                    <th><i class="fas fa-graduation-cap"></i> Formation</th>
                    <th class="text-center"><i class="fas fa-cogs"></i> Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center fst-italic text-muted py-3">
                            Aucun encadrant trouvé.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Nom</td>
                            <td>@item.Prenom</td>
                            <td>@item.Email</td>
                            <td>@item.Telephone</td>
                            <td>@(item.Formation != null ? item.Formation.Titre : "Aucune")</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm me-1" title="Détails">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" title="Supprimer"
                                   onclick="return confirm('Confirmer la suppression de cet encadrant ?');">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

@if (ViewBag.TotalPages > 1)
{
    <div class="fixed-pagination">
        <span>Page @ViewBag.CurrentPage sur @ViewBag.TotalPages</span>

        <div>
            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" class="btn btn-outline-primary btn-sm " aria-label="Page précédente">
                    <i class="fas fa-chevron-left"></i> Précédent
                </a>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <a asp-action="Index" asp-route-page="@i"
                   class="btn btn-sm @(i == ViewBag.CurrentPage ? "btn-primary" : "btn-outline-secondary")"
                   aria-current="@(i == ViewBag.CurrentPage ? "page" : null)">
                    @i
                </a>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" class="btn btn-outline-primary btn-sm" aria-label="Page suivante">
                    Suivant <i class="fas fa-chevron-right"></i>
                </a>
            }
        </div>
    </div>
}
</div>