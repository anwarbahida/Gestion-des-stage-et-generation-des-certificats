@model appWeb.Models.Stagiaire
@{
    ViewData["Title"] = "Supprimer le stagiaire";
}
@section Styles {
    <link rel="stylesheet" href="~/css/site-delete.css" />
}


<h1 class="delete-title">Supprimer le stagiaire</h1>
<h3 class="delete-subtitle">Êtes-vous sûr de vouloir supprimer ce stagiaire ?</h3>

<div class="delete-card">
    <h4 class="section-title">Stagiaire</h4>
    <dl class="row">
        <dt class="col-sm-2">Nom</dt>
        <dd class="col-sm-10">@Model.Nom</dd>

        <dt class="col-sm-2">Prénom</dt>
        <dd class="col-sm-10">@Model.Prenom</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Date de naissance</dt>
        <dd class="col-sm-10">@Model.DateNaissance.ToString("dd/MM/yyyy")</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Supprimer</button>
    <a asp-action="Index" class="btn btn-secondary">Annuler</a>
</form>
