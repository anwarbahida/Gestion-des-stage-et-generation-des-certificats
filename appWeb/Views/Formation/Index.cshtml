@model IEnumerable<appWeb.Models.Formation>

@{
    ViewData["Title"] = "Liste des formations";
}

<style>
    .page-container {
        max-width: 960px;
        margin: auto;
        padding: 1rem;
    }

    h2 {
        text-align: center;
        margin-bottom: 1.5rem;
        color: #0d6efd; /* bleu Bootstrap primaire */
    }

    .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    th i {
        margin-right: 6px;
        color: #0d6efd;
    }

    .btn-sm i {
        margin-right: 4px;
    }
    @@media (max-width: 576px) {
        .btn-sm

    {
        font-size: 1rem;
        padding: 0.4rem 0.75rem;
    }

    table th, table td {
        font-size: 0.9rem;
    }

    }
</style>

<div class="page-container">
    <h2>@ViewData["Title"]</h2>

    <p class="text-center mb-4">
        <a asp-action="Create" class="btn btn-primary btn-lg">
            <i class="fas fa-plus-circle me-2"></i> Créer une nouvelle formation de stage
        </a>
    </p>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-primary">
                <tr>
                    <th><i class="fas fa-book"></i> Titre</th>
                    <th><i class="fas fa-align-left"></i> Description</th>
                    <th><i class="fas fa-calendar-alt"></i> Date début</th>
                    <th><i class="fas fa-calendar-check"></i> Date fin</th>
                    <th class="text-center"><i class="fas fa-cogs"></i> Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center fst-italic text-muted py-3">
                            Aucune formation trouvée.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var formation in Model)
                    {
                        <tr>
                            <td>@formation.Titre</td>
                            <td>@formation.Description</td>
                            <td>@formation.DateDebut.ToShortDateString()</td>
                            <td>@formation.DateFin.ToShortDateString()</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@formation.Id" class="btn btn-info btn-sm me-1" title="Détails">
                                    <i class="fas fa-info-circle"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@formation.Id" class="btn btn-warning btn-sm me-1" title="Modifier">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@formation.Id" class="btn btn-danger btn-sm" title="Supprimer"
                                   onclick="return confirm('Confirmer la suppression de cette formation ?');">
                                    <i class="fas fa-trash-alt"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div class="fixed-pagination">
            <span>Page @ViewBag.CurrentPage sur @ViewBag.TotalPages</span>

            <div>
                @if (ViewBag.CurrentPage > 1)
                {
                    <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" class="btn btn-outline-primary btn-sm me-1">
                        <i class="fas fa-chevron-left"></i> Précédent
                    </a>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <a asp-action="Index" asp-route-page="@i"
                       class="btn btn-sm @(i == ViewBag.CurrentPage ? "btn-primary" : "btn-outline-secondary")">@i</a>
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" class="btn btn-outline-primary btn-sm ms-1">
                        Suivant <i class="fas fa-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>
