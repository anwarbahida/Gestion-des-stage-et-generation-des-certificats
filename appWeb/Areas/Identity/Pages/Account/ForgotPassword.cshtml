@page
@model ForgotPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Mot de passe oublié";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - YourApp</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 1rem;
            color: #212529;
        }

        .container {
            background-color: #fff;
            border-radius: 1rem;
            box-shadow: 0 0.5rem 2rem rgba(0, 0, 0, 0.2);
            padding: 2.5rem 3rem;
            max-width: 420px;
            width: 100%;
        }

        h1, h2 {
            text-align: center;
            color: #222;
            margin-bottom: 1.5rem;
        }

        .form-floating {
            position: relative;
            margin-bottom: 1.75rem;
        }

            .form-floating input {
                width: 100%;
                padding: 1.25rem 1rem 0.375rem 2.5rem;
                font-size: 1rem;
                border: 1.5px solid #ced4da;
                border-radius: 0.5rem;
                background: transparent;
                transition: border-color 0.3s ease, box-shadow 0.3s ease;
            }

                .form-floating input:focus {
                    border-color: #2575fc;
                    box-shadow: 0 0 0 0.25rem rgba(37, 117, 252, 0.4);
                    background-color: #fff;
                }

            .form-floating label {
                position: absolute;
                top: 1.25rem;
                left: 2.5rem;
                padding: 0 0.25rem;
                color: #6c757d;
                font-size: 1rem;
                pointer-events: none;
                background-color: #fff;
                transition: all 0.25s ease-in-out;
                border-radius: 0.25rem;
            }

            .form-floating input:focus + label,
            .form-floating input:not(:placeholder-shown) + label {
                top: 0.25rem;
                left: 2.25rem;
                font-size: 0.75rem;
                color: #2575fc;
                font-weight: 600;
            }

            .form-floating i {
                position: absolute;
                top: 50%;
                left: 0.9rem;
                transform: translateY(-50%);
                color: #6c757d;
                font-size: 1rem;
            }

        .text-danger {
            font-size: 0.875rem;
            margin-top: -1rem;
            margin-bottom: 1rem;
            color: #dc3545;
            font-weight: 600;
        }

        button[type="submit"] {
            width: 100%;
            padding: 1rem 0;
            font-size: 1.125rem;
            font-weight: 700;
            color: white;
            background-color: #2575fc;
            border: none;
            border-radius: 0.75rem;
            cursor: pointer;
            box-shadow: 0 0.5rem 1rem rgba(37, 117, 252, 0.5);
            transition: background-color 0.3s ease, box-shadow 0.3s ease;
        }

            button[type="submit"]:hover {
                background-color: #1a54d1;
            }

        a {
            color: #2575fc;
            font-weight: 600;
            text-decoration: none;
        }

            a:hover {
                text-decoration: underline;
            }
    </style>
</head>
<body>

    <div class="container">
        <h1>@ViewData["Title"]</h1>
        <form method="post">
            <h2>Recevoir un lien de réinitialisation</h2>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3 position-relative">
                <input asp-for="Input.Email" class="form-control ps-5" autocomplete="email" aria-required="true" placeholder="Email" />
                <label asp-for="Input.Email">Email</label>
                <i class="fa fa-envelope position-absolute"></i>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <button type="submit">Envoyer</button>
            <div class="mt-3 text-center">
                <a asp-page="./Login">Retour à la connexion</a>
            </div>
        </form>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>
