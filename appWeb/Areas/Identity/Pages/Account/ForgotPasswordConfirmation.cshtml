@page
@model ForgotPasswordConfirmationModel

@{
    Layout = null;
    ViewData["Title"] = "Confirmation du mot de passe oublié";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - YourApp</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #6a11cb, #2575fc);
            color: #333;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
        }

        .confirmation-box {
            background: #fff;
            padding: 3rem 2.5rem;
            border-radius: 1rem;
            text-align: center;
            box-shadow: 0 1rem 2rem rgba(0, 0, 0, 0.2);
            max-width: 480px;
            width: 90%;
        }

            .confirmation-box h1 {
                color: #2575fc;
                margin-bottom: 1rem;
            }

            .confirmation-box p {
                font-size: 1.1rem;
                margin-bottom: 2rem;
            }

            .confirmation-box a {
                color: #2575fc;
                font-weight: bold;
                text-decoration: none;
            }

                .confirmation-box a:hover {
                    text-decoration: underline;
                }
    </style>
</head>
<body>
    <center>
    <div class="confirmation-box">
        <h1>@ViewData["Title"]</h1>
        <p>Si un compte existe avec l'email fourni, un lien de réinitialisation a été envoyé. Veuillez vérifier votre boîte de réception.</p>
        <a asp-page="./Login">Retour à la page de connexion</a>
    </div>
    </center>
</body>
</html>
