@page
@model LogoutModel
@{
    ViewData["Title"] = "Déconnexion";
}

<header>
    <h1>@ViewData["Title"]</h1>

    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <!-- ✅ Bouton de déconnexion qui redirige vers la page Login.cshtml après déconnexion -->
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
              asp-route-returnUrl="~/Account/Login" method="post">
            <button type="submit" class="btn btn-danger">Se déconnecter</button>
        </form>
    }
    else
    {
        <!-- ✅ Message affiché si l'utilisateur est déjà déconnecté -->
        <p>Vous avez été déconnecté. <a href="~/Account/Login">Cliquez ici pour vous reconnecter</a>.</p>
    }
</header>
