@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Modifier le mot de passe";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<!-- Page title -->
<div class="text-center mb-5">
    <h2 class="fw-bold text-primary">@ViewData["Title"]</h2>
    <p class="text-muted">Veuillez remplir le formulaire pour mettre à jour votre mot de passe.</p>
</div>

<!-- Status message partial -->
<partial name="_StatusMessage" for="StatusMessage" />

<!-- Form container -->
<div class="d-flex justify-content-center">
    <div class="card shadow-lg rounded-4 p-4" style="width: 100%; max-width: 500px;">
        <form id="change-password-form" method="post" class="needs-validation" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <!-- Old password -->
            <div class="form-floating mb-4 position-relative">
                <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Ancien mot de passe" />
                <label asp-for="Input.OldPassword"><i class="bi bi-lock-fill me-2"></i>Ancien mot de passe</label>
                <span asp-validation-for="Input.OldPassword" class="text-danger position-absolute top-100 start-0"></span>
            </div>

            <!-- New password -->
            <div class="form-floating mb-4 position-relative">
                <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Nouveau mot de passe" />
                <label asp-for="Input.NewPassword"><i class="bi bi-shield-lock-fill me-2"></i>Nouveau mot de passe</label>
                <span asp-validation-for="Input.NewPassword" class="text-danger position-absolute top-100 start-0"></span>
            </div>

            <!-- Confirm password -->
            <div class="form-floating mb-4 position-relative">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirmer le nouveau mot de passe" />
                <label asp-for="Input.ConfirmPassword"><i class="bi bi-check2-circle me-2"></i>Confirmer le mot de passe</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger position-absolute top-100 start-0"></span>
            </div>

            <!-- Submit button -->
            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg rounded-pill">
                    <i class="bi bi-save me-2"></i>Mettre à jour le mot de passe
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}
